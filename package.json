{
  "name": "apprun-log-sql-clone",
  "version": "1.0.0",
  "description": "A clone of Logseq in AppRun",
  "main": "main.js",
  "bin": "cli.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pretest": "npm run build -w outliner",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w outliner",
    "dev:e2e": "npm run dev:e2e -w outliner",
    "prebuild": "npm run build -w outliner",
    "prestart": "npm run build",
    "start": "electron .",
    "build": "vite build --sourcemap --minify",
    "prewatch": "npm run build -w outliner",
    "watch": "vite build --sourcemap --watch",
    "predev": "npm run build -w outliner",
    "dev": "vite dev --port 8080",
    "serve": "node cli docs",
    "create-types": "tsc src/model/index.ts --declaration --emitDeclarationOnly --skipLibCheck",
    "push:outliner": "git subtree push --prefix packages/outliner https://github.com/yysun/outliner.git main",
    "push:llm-runtime": "git subtree push --prefix packages/llm-runtime https://github.com/yysun/llm-runtime.git main",
    "pull:outliner": "git subtree pull --prefix packages/outliner https://github.com/yysun/outliner.git main --squash",
    "pull:llm-runtime": "git subtree pull --prefix packages/llm-runtime https://github.com/yysun/llm-runtime.git main --squash"
  },
  "repository": "",
  "keywords": [],
  "author": "Yiyi Sun",
  "license": "CC0-1.0",
  "devDependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "apprun": "^3.38.0",
    "autoprefixer": "^10.4.27",
    "date-fns": "^4.1.0",
    "electron": "^41.1.1",
    "fuse.js": "^7.3.0",
    "idb-keyval": "^6.2.2",
    "jsdom": "^29.0.1",
    "llm-runtime": "workspace:*",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.1",
    "outliner": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-filename": "^1.6.4",
    "tailwindcss": "^4.2.2",
    "turndown": "^7.2.4",
    "typescript": "^6.0.2",
    "uuid": "^13.0.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "ws": "^8.20.0"
  }
}
